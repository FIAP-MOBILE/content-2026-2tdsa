    {
      "id": "f8fa4aeb-6d3f-48a5-9de9-9ac2ad136c06",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Agora é necessário fazer algumas configurações no seu aplicativo.\nPrimeiro, abra o arquivo ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "android/build.gradle",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ". Na seção ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "buildscript",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ", existe a seção\n",
          "styles": {}
        },
        {
          "type": "text",
          "text": "dependencies",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ". Dentro dela deve ser adicionada a seguinte dependência ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "com.google.gms.google-services",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ":",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "b84caa34-bffe-4a5f-bdbf-94b426ee22b4",
      "type": "codeBlock",
      "props": {
        "language": "gradle"
      },
      "content": [
        {
          "type": "text",
          "text": "buildscript {\n    ext {\n        buildToolsVersion = '34.0.0'\n        minSdkVersion = 23\n        compileSdkVersion = 34\n        targetSdkVersion = 34\n        ndkVersion = '26.1.10909125'\n        kotlinVersion = '1.9.22'\n    }\n    repositories {\n        google()\n        mavenCentral()\n    }\n    dependencies {\n        classpath('com.android.tools.build:gradle')\n        classpath('com.facebook.react:react-native-gradle-plugin')\n        classpath('org.jetbrains.kotlin:kotlin-gradle-plugin')\n        classpath('com.google.gms.google-services:4.4.2')\n    }\n}",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "f0c346b4-36fe-4331-a369-a4b6ab3c7eca",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Agora abra o arquivo ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "android/app/build.gradle",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ". Logo após a primeira linha, adicione a\nseguinte linha:",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "bee12363-ce09-45ad-aa0d-6fe8ffec3232",
      "type": "codeBlock",
      "props": {
        "language": "gradle"
      },
      "content": [
        {
          "type": "text",
          "text": "apply plugin: \"com.google.gms.google-services\"",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "003a643a-f3d3-41d4-8447-900175016907",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Depois, na seção ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "dependencies",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " adicione a seguinte dependência:",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "341e5d5b-153c-4940-8933-d2f28a3f9c03",
      "type": "codeBlock",
      "props": {
        "language": "gradle"
      },
      "content": [
        {
          "type": "text",
          "text": "dependencies {\n    // The version of react-native is set by the React Native Gradle Plugin\n    implementation('com.facebook.react:react-android')\n\n    if (hermesEnabled.toBoolean()) {\n        implementation('com.facebook.react:hermes-android')\n    } else {\n        implementation jscFlavor\n    }\n    implementation platform('com.google.firebase:firebase-bom:33.1.2')\n}",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "4e3f67bf-1c83-4d53-923a-d0af247794d0",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Para utilizar o Firebase no seu projeto, primeiro deve-se instalar sua respectiva biblioteca.",
