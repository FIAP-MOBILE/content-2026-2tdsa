        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Quase tudo no React é consistido de componentes.\nExistem duas abordagens de se criar componentes:",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "35dfac29-9d3e-4922-8de4-a67d262fc534",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Classes",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "87641722-8bff-4858-b8c4-9338e288f1fc",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Funcional",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "6ebfe4fd-9f70-4aca-b3a2-b10956c087fd",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "A ideia de classe pode ser descrita como um modelo que define quais seus atributos e comportamentos para manipular os dados.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "19b3fabc-c400-4662-b4b2-97e9fef1e32a",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "import React, { Component } from 'react';\n\nclass Table extendes Component {\n    render() {\n        return (\n            <table>\n                <thead>\n                    <tr>\n                        <th>Name</th>\n                        <th>Job</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <td>Charlie</td>\n                        <td>Janitor</td>\n                    </tr>\n                    <tr>\n                        <td>Mac</td>\n                        <td>Bouncer</td>\n                    </tr>\n                </tbody>\n            </table>\n        )\n    }\n}\n\nexport default Table;",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "1f6f6313-6b8f-44c6-a916-c7dd3e85f9e6",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Métodos mais importantes:\n",
          "styles": {}
        },
        {
          "type": "text",
          "text": "render",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " - Define o que deverá ser exibido na tela. Implementação obrigatória\n",
          "styles": {}
        },
        {
          "type": "text",
          "text": "componentDidMount",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " - Executado quando o elemento será exibido pela primeira vez\n",
          "styles": {}
        },
        {
          "type": "text",
          "text": "setState",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " - Usado para atualizar o estado do componente",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "6e850d29-fd0d-4aa8-b162-08d2c09cdd0d",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "É a abordagem recomendada pelo próprio ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "React",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ". É a forma mais simples de se criar um componente, tendo em vista que é necessário apenas escrever uma\nfunção. Para controlar o estado do componente, se utiliza o hook ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "useState",
          "styles": {
            "code": true
          }
        }
      ],
      "children": []
    },
    {
      "id": "bdf1fb16-b823-4a19-a10f-990460b099da",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "import React from 'react';\n\nconst Table = () => {\n  return (\n    <table>\n      <thead>\n        <tr>\n          <th>Name</th>\n          <th>Job</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>Charlie</td>\n          <td>Janitor</td>\n        </tr>\n        <tr>\n          <td>Mac</td>\n          <td>Bouncer</td>\n        </tr>\n      </tbody>\n    </table>\n  );\n};\n\nexport default Table;",
          "styles": {}
        }
      ],
      "children": []
