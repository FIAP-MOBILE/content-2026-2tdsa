        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Ao usar o Node, temos duas opções para criar o projeto. A Meta recomenda usar algum framework como o ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "[Nextjs](https://nextjs.org/)",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " ou o ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "[Expo](https://expo.dev/)\n",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": "Criando com o ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "Expo\nnpx create-expo-app@latest <nome do projeto>",
          "styles": {
            "code": true
          }
        }
      ],
      "children": []
    },
