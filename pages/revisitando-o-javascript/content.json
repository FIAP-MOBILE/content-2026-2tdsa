    },
    {
      "id": "477a3d35-3458-4359-af11-1e59815fdeee",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "function soma(a, b) {\n  return a + b;\n}\n\nconsole.log(soma(3, 4));",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "1bc8024d-1d50-463c-a55b-81280a78c277",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "É possível criar funções com parâmetros opcionais",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "094da722-400d-4a5f-a732-7e2144bbac6d",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "function soma(a, b = 0) {\n  return a + b;\n}\n\nconsole.log(soma(3));",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "2f92ff74-1cd0-494e-97d7-e69c5b5418aa",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "let digaOla = function () {\n  console.log('Olá');\n};\n\ndigaOla();\n\nconst idade = 16;\nlet bemVindo;\nif (idade < 18) {\n  bemVindo = function () {\n    console.log('Olá');\n  };\n} else {\n  bemVindo = function () {\n    console.log('Saudações');\n  };\n}\n\nbemVindo();",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "30ba3db2-74f7-451b-9a02-644600f3d712",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "const soma = (a, b) => a + b;\nconsole.log(soma(3, 4));\n\nconst dobro = (n) => n * 2;\nconsole.log(dobro(4));\n\nconst digaOla = () => console.log('Olá');\ndigaOla();\n\nconst sayHello = (_) => console.log('Hello');\nsayHello();\n\nconst subtracao = (a, b) => {\n  const resultado = a - b;\n  return resultado;\n};\nconsole.log(subtracao(10, 8));",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "62bd2f26-f0b8-43d4-ae09-8de3aca598f8",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "\n\n",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "51a6c3c2-f8fa-420d-aaad-e49421da6d26",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Uma característica importante das ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "Arrow Functions",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " é que não se pode declarar paramêtros com o mesmo nome na sua definição",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "bedd8fc7-5ad1-46b4-999e-ae48d508ec6a",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "O Spread Operator é representado por três pontos ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "...",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " e converte um array em elementos individuais.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "b968fdac-84ba-4d68-83f5-baa254709d58",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "const meuArray = [1, 2, 3];\nconsole.log(meuArray);\nconsole.log(...meuArray);\nconsole.log([...meuArray, 4, 5, 6]);",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "a959e761-806e-4658-ae70-addce6662818",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Podemos utilizar os mesmos recursos para objetos. Com ele, duplicamos seus valores em um novo objeto.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "7874eb9a-6797-44ed-aecf-a0c274858f82",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "const data = { firstName: 'Leonardo', lastName: 'Bragatti' };\nconsole.log({ ...data, email: 'email@email.com' });",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "864c7aa9-7851-4c5a-a9b0-512cdc2e0a31",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "A técnica de Destructuring permite a quebra de estrutura complexas em partes únicas.\nÉ possível aplicá-la em Arrays e Objetos:",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "d52b5070-0aef-4487-986a-1a746c36bfc0",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "const meuArray = ['azul', 'vermelo', 'verde'];\nconst [cor1, cor2, cor3] = meuArray;\n\nconsole.log(cor1);\nconsole.log(cor2);\nconsole.log(cor3);\n\nconst meuObjeto = { x: 10, y: 20, z: 30 };\nconst { x, y } = meuObjeto;\n\nconsole.log(x);\nconsole.log(y);",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "69b69937-6203-40fd-bbdf-99bc46abd3c6",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Javascript não tem uma implementação robusta de orientação a objetos. Mas é possível criar objetos no seu código.\nObjetos em Javascript pode ser criados sem uso de classes, criando estruturas em tempo de execução.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "5ddb2f37-218b-4aee-87d7-3e818795d1d7",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "const carro1 = { marca: 'Fiat', modelo: '500', cor: 'Branco' };\nconst carro2 = { marca: 'Fiat', modelo: '500', cor: 'Branco' };\n\nconsole.log(carro1);\nconsole.log(carro1.marca);\nconsole.log(carro1.modelo);\nconsole.log(carro1.cor);\n\nconsole.log(carro2);\nconsole.log(carro2.marca);\nconsole.log(carro2.modelo);\nconsole.log(carro2.cor);",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "4ccc8cb4-171a-47b2-900a-334e8d0e7f30",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Definindo objetos com declaração literal.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "505498e1-ccb6-446d-92e9-7d26f7f02d68",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "const pessoa = {\n  nome: 'Mario',\n  sobrenome: 'de Andrade',\n  id: 4483,\n  nomeCompleto: () => {\n    return `${this.nome} ${this.sobrenome}`.trim();\n  },\n};\nconsole.log(pessoa);\nconsole.log(pessoa.nomeCompleto());",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "3d6a3b60-9540-404c-924a-3cbed82a3a17",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Instância de objetos a partir de implementação vazia",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "4eb76700-8ff4-4cec-bbf2-6758635ad5a8",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "const criarNovaPessoa = (nome) => {\n  const obj = {};\n  obj.nome = nome;\n\n  obj.saudacao = () => {\n    console.log(`Olá, ${obj.nome}`);\n  };\n\n  return obj;\n};\n\nconst pessoa = criarNovaPessoa('Ale');\npessoa.saudacao();",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "f0c19920-919c-42a3-940f-eb72ee65258b",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Instância de objetos utilizando função que representa uma classe e o operador ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "new",
          "styles": {
            "code": true
          }
        }
      ],
      "children": []
    },
    {
      "id": "85d5e7ff-cc30-45d1-b90b-8da2095d5062",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "function Pessoa(nome) {\n  this.nome = nome;\n  this.saudacao = () => {\n    console.log(`Olá, ${this.nome}`);\n  };\n}\n\nconst pessoa = new Pessoa('Ale');\npessoa.saudacao();",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "f1653583-7421-4cb0-a24c-47fdcbdaf5b8",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "É possível escrever códigos orientados a objetos de forma clara, com sintaxe parecida com outras linguagens de programação",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "05a48051-7c8c-4d2e-b150-854465214d9f",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "class Pessoa {\n  // Constructor\n  constructor() {\n    this.nome = '';\n    this.email = '';\n  }\n}\n\nconst pessoa = new Pessoa();\npessoa.nome = 'João';\nconsole.log(pessoa.nome);",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "433cf2e7-15bb-4038-afeb-2a8742e79158",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Javascript não possui modificadores de visibilidade: público, privado ou protegido.\nPara deixar claro que algo é privado, usamos o ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "_",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " (underline) antes do nome do atributo e manipulamos seu valor através de métodos ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "get",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " e ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "set",
          "styles": {
            "code": true
          }
        }
      ],
      "children": []
    },
    {
      "id": "5c2ed586-ef74-43c6-a69e-880d5ea8cf8c",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "class Pessoa {\n  // Constructor\n  constructor() {\n    this._nome = ''; // \"privado\"\n  }\n\n  get nome() {\n    return this._nome;\n  }\n\n  set nome(value) {\n    this._nome = value;\n  }\n}\n\nconst pessoa = new Pessoa();\npessoa.nome = 'João'; // Sem a sintaxe do metódo\nconsole.log(pessoa.nome);",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "a3631db8-4374-41f2-9cd3-8b9198aa9a22",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "É possível definir métodos estáticos",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "663a3f96-fabd-4761-8c8f-8882207ded96",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "class Pessoa {\n  // Constructor\n  constructor(nome) {\n    this._nome = '';\n  }\n\n  get nome() {\n    return this._nome;\n  }\n\n  static qualClasseSou() {\n    console.log('Sou a classe Pessoa.');\n  }\n}\n\nconst pessoa = new Pessoa('Ale');\nPessoa.qualClasseSou();",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "cf56e6c6-9263-433a-873e-48222dbb2034",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Utilizando herança de objetos",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "71cdf1fc-cb6b-4252-85ae-560dce8fd943",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "class Carro {\n  constructor(marca) {\n    this.marca = marca;\n  }\n}\n\nclass SUV extends Carro {\n  constructor(marca, tipoCambio) {\n    super(marca);\n    this.tipoCambio = tipoCambio;\n  }\n}\n\nconst suv = new SUV('Honda', 'Automatico');\nconsole.log(suv.marca);\nconsole.log(suv.tipoCambio);",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "d72e3a56-9eaa-41a5-a4d7-aa526a2e478e",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Módulos são pedaços de códigos JavaScript escritos em um arquivo de modo que seja possível usar apenas um trecho deste arquivo dentro de outro arquivo.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "833ed6e1-af32-40e0-bfff-e41cd0358b27",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Eles podem ser exportados de forma nomeada ou forma default.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "94b9bfa1-9a6b-43bc-b42f-9d51cc2637f1",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Dentro de outro arquivo, eles serão importados, podendo usar a técnica de ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "Destructuring",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ".",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "243fbdc0-a794-4443-a223-f6b6c3268ce5",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Isso facilita a componentização do código, deixando-o mais organizado e legível.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "719f87f3-9e00-40e4-a40b-451f93b2b329",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Classes, funções e variáveis presentes em um arquivo podem ser exportadas de\nforma nomeada. Ex: arquivo ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "MeuModulo.js",
          "styles": {
            "code": true
          }
        }
      ],
      "children": []
    },
    {
      "id": "75e65923-5529-4a7a-b5a2-4e0c70d09ce8",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "class MinhaClasse {\n  show() {\n    console.log('Um metódo dentro da classe');\n  }\n}\n\nconst minhaFuncao = (_) => console.log('Uma função');\nconst minhaVariavel = 10;\n\nexport { MinhaClasse, minhaFuncao, minhaVariavel };",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "80c6ac6b-ce3d-4da9-a1ee-29b5767bf9aa",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Para importar somente a MinhaClasse do arquivo ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "MeuModulo.js",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " dentro do ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "index.js",
          "styles": {
            "code": true
          }
        }
      ],
      "children": []
    },
    {
      "id": "d3d0a205-078b-48b2-90a2-4495fbe9c6a9",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "import { MinhaClasse } from './MeuModulo.js';\n\nconst a = new MinhaClasse();\na.show();",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "634e38a4-ee34-45d8-b191-68919f113cd9",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Para executar usando o NodeJS, sem o uso do Babel, adicione a linha ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "type",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ", conforme abaixo, no arquivo ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "package.json",
          "styles": {
            "code": true
          }
        }
      ],
      "children": []
    },
    {
      "id": "c27e0901-4643-4ce1-b632-b91b418fea1a",
      "type": "codeBlock",
      "props": {
        "language": "json"
      },
      "content": [
        {
          "type": "text",
          "text": "{\n  \"name\": \"Teste\",\n  \"version\": \"1.0.0\",\n  \"description\": \"\",\n  \"main\": \"index.js\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\"\n}",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "2e9cb29d-4eb0-4ade-8b42-dbba847afee0",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Módulos podem ter um ",
          "styles": {}
        },
