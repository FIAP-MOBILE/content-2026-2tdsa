          },
          "content": [
            {
              "type": "text",
              "text": "axios.interceptors.request.use((config) => {\n  console.log('Segundo interceptor');\n  return config;\n});\n\naxios.interceptors.request.use((config) => {\n  console.log('Primeiro interceptor');\n  return config;\n});\n\naxios.interceptors.response.use((config) => {\n  console.log('Primeiro interceptor');\n  return config;\n});\n\naxios.interceptors.response.use((config) => {\n  console.log('Segundo interceptor');\n  return config;\n});",
              "styles": {}
