      "content": [
        {
          "type": "text",
          "text": "const a = 10;\nconst b = 20;\n\n// Sem template string\nconst msg = 'A = ' + a + 'B = ' + B;\nconsole.log(msg2);\n\n// Com template string\nconst msg2 = `A = ${a} B = ${b}`;\nconsole.log(msg2);",
