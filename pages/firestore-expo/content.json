        {
          "id": "c6cd0982-53a9-437f-813c-69357eb49e3d",
          "type": "codeBlock",
          "props": {
            "language": "typescript"
          },
          "content": [
            {
              "type": "text",
              "text": "const doc = firestore.doc(collection, '5wZV4I2TECWo7fnPVXdH');\nconst item = await firestore.getDoc(doc);\nconst data = item.data();",
              "styles": {}
            }
          ],
          "children": []
