    {
      "id": "0165c357-127e-48ce-87af-1367fbe50e97",
      "type": "codeBlock",
      "props": {
        "language": "javascript"
      },
      "content": [
        {
          "type": "text",
          "text": "import React, { useEffect, useState } from \"react\";\nimport { Text, View, Button } from \"react-native\";\n\nimport {\n  request,\n  PERMISSIONS,\n  check,\n  openSettings,\n} from \"react-native-permissions\";\n\nconst App = () => {\n  const [isGranted, setIsGranted] = useState<boolean>();\n\n  const requestCameraPermission = async () => {\n    try {\n      const result = await request(PERMISSIONS.ANDROID.CAMERA);\n      setIsGranted(result === \"granted\");\n    } catch (error) {\n      setIsGranted(false);\n    }\n  };\n\n  const checkCameraPermission = async () => {\n    const result = await check(PERMISSIONS.ANDROID.CAMERA);\n    setIsGranted(result === \"granted\");\n  };\n\n  const showSettings = () => {\n    openSettings(\"application\");\n  };\n\n  useEffect(() => {\n    checkCameraPermission();\n  }, []);\n\n  return (\n    <View>\n      <Button title=\"Solicitar permissão\" onPress={requestCameraPermission} />\n      <Button title=\"Ver configurações\" onPress={showSettings} />\n      <Text>Permissão {isGranted ? \"concedida\" : \"negada\"}</Text>\n    </View>\n  );\n};\n\nexport default App;",
          "styles": {}
        }
      ],
      "children": []
    },
