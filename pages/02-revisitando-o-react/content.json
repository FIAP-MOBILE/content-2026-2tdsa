          "children": []
        },
        {
          "id": "73c88aec-cf99-4e0a-b5b2-6ca57179b47a",
          "type": "heading",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left",
            "level": 2,
            "isToggleable": true
          },
          "content": [
            {
              "type": "text",
              "text": "Classes",
              "styles": {}
            }
          ],
          "children": [
            {
              "id": "e0d209c6-54f0-45c4-9b96-4325a14cf0e4",
              "type": "paragraph",
              "props": {
                "backgroundColor": "default",
                "textColor": "default",
                "textAlignment": "left"
              },
              "content": [
                {
                  "type": "text",
                  "text": "A ideia de classe pode ser descrita como um modelo que define quais seus atributos e comportamentos para manipular os dados.",
                  "styles": {}
                }
              ],
              "children": []
            },
            {
              "id": "2220dead-4517-4930-95de-9006d796ad5f",
              "type": "codeBlock",
              "props": {
                "language": "javascript"
              },
              "content": [
                {
                  "type": "text",
                  "text": "import React, { Component } from 'react';\n\nclass Table extendes Component {\n    render() {\n        return (\n            <table>\n                <thead>\n                    <tr>\n                        <th>Name</th>\n                        <th>Job</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <td>Charlie</td>\n                        <td>Janitor</td>\n                    </tr>\n                    <tr>\n                        <td>Mac</td>\n                        <td>Bouncer</td>\n                    </tr>\n                </tbody>\n            </table>\n        )\n    }\n}\n\nexport default Table;",
                  "styles": {}
                }
              ],
              "children": []
            },
            {
              "id": "1da3a815-43d8-4eb7-aff5-47f3eb44117d",
              "type": "paragraph",
              "props": {
                "backgroundColor": "default",
                "textColor": "default",
                "textAlignment": "left"
              },
              "content": [
                {
                  "type": "text",
                  "text": "Métodos mais importantes:\n",
                  "styles": {}
                },
                {
                  "type": "text",
                  "text": "render",
                  "styles": {
                    "code": true
                  }
                },
                {
                  "type": "text",
                  "text": " - Define o que deverá ser exibido na tela. Implementação obrigatória\n",
                  "styles": {}
                },
                {
                  "type": "text",
                  "text": "componentDidMount",
                  "styles": {
                    "code": true
                  }
                },
                {
                  "type": "text",
                  "text": " - Executado quando o elemento será exibido pela primeira vez\n",
                  "styles": {}
                },
                {
                  "type": "text",
                  "text": "setState",
                  "styles": {
                    "code": true
                  }
                },
                {
                  "type": "text",
                  "text": " - Usado para atualizar o estado do componente",
                  "styles": {}
                }
              ],
              "children": []
            }
          ]
        },
        {
          "id": "661d8ea5-8efb-4336-a3fb-6e872c8ac8e3",
          "type": "heading",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left",
            "level": 2,
            "isToggleable": true
          },
          "content": [
            {
              "type": "text",
              "text": "Funcional",
              "styles": {}
            }
          ],
          "children": [
            {
              "id": "87dfddec-f1db-4648-aef4-94f5a0130616",
              "type": "paragraph",
              "props": {
                "backgroundColor": "default",
                "textColor": "default",
                "textAlignment": "left"
              },
              "content": [
                {
                  "type": "text",
                  "text": "É a abordagem recomendada pelo próprio ",
                  "styles": {}
                },
                {
                  "type": "text",
                  "text": "React",
                  "styles": {
                    "code": true
                  }
                },
                {
                  "type": "text",
                  "text": ". É a forma mais simples de se criar um componente, tendo em vista que é necessário apenas escrever uma\nfunção. Para controlar o estado do componente, se utiliza o hook ",
                  "styles": {}
                },
                {
                  "type": "text",
                  "text": "useState",
                  "styles": {
                    "code": true
                  }
                }
              ],
              "children": []
            },
            {
              "id": "741977f6-0066-46fa-a851-fe5c2392aa28",
              "type": "codeBlock",
              "props": {
                "language": "javascript"
              },
              "content": [
                {
                  "type": "text",
                  "text": "import React from 'react';\n\nconst Table = () => {\n  return (\n    <table>\n      <thead>\n        <tr>\n          <th>Name</th>\n          <th>Job</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>Charlie</td>\n          <td>Janitor</td>\n        </tr>\n        <tr>\n          <td>Mac</td>\n          <td>Bouncer</td>\n        </tr>\n      </tbody>\n    </table>\n  );\n};\n\nexport default Table;",
                  "styles": {}
                }
              ],
              "children": []
            }
          ]
        }
      ]
    },
    {
      "id": "238ae353-a1a1-4fb3-958f-edabc711122d",
      "type": "heading",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left",
