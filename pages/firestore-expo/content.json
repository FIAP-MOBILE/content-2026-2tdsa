          "type": "paragraph",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "É possível aplicar filtros para obter os documentos do ",
              "styles": {}
